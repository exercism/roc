#!/usr/bin/env bash

# Synopsis:
# Install Roc

set -e

function download_release() {
    local install_dir="${1}"

    local os platform
    os=$(uname -s)
    case "$os" in
        Linux*)  platform="linux" ;;
        Darwin*) platform="macos" ;;
        *) echo "Unsupported OS: $os" >&2; exit 1 ;;
    esac

    local arch arch_name
    arch=$(uname -m)
    case "$arch" in
        x86_64) arch_name="x86_64" ;;
        arm64|aarch64)
            if [[ "$platform" == "macos" ]]; then
                arch_name="apple_silicon"
            else
                arch_name="arm64"
            fi
            ;;
        *) echo "Unsupported architecture: $arch" >&2; exit 1 ;;
    esac

    echo "Fetching latest Roc version info from exercism/roc-test-runner..."
    local dockerfile
    if command -v curl >/dev/null 2>&1; then
        dockerfile=$(curl -fsSL https://raw.githubusercontent.com/exercism/roc-test-runner/main/Dockerfile)
    else
        dockerfile=$(wget -qO- https://raw.githubusercontent.com/exercism/roc-test-runner/main/Dockerfile)
    fi

    local roc_version
    roc_version=$(echo "$dockerfile" | sed -n 's/^ARG ROC_VERSION="\([^"]*\)"$/\1/p' | head -n1)

    if [[ ! "$roc_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([_-][A-Za-z0-9][A-Za-z0-9._-]*)?$ ]]; then
        echo "Failed to parse ROC_VERSION from roc-test-runner Dockerfile" >&2
        exit 1
    fi

    local release_dir="roc-${platform}_${arch_name}-${roc_version}"
    local file_name="${release_dir}.tar.gz"
    local download_url="https://github.com/roc-lang/roc/releases/download/${roc_version}/${file_name}"

    rm -rf "${install_dir}"
    mkdir -p "${install_dir}"
    cd "${install_dir}"

    echo "Downloading ${download_url}..."
    if command -v curl >/dev/null 2>&1; then
        curl -fL -o "${file_name}" "${download_url}"
    else
        wget -qO "${file_name}" "${download_url}"
    fi
    echo "Extracting ${file_name}..."
    tar -xzf "${file_name}"
    rm "${file_name}"
    ln -s "${release_dir}/roc" roc
}

function update_shell {
    local install_dir="${1}"
    local file="${HOME}/${2}"

    if [[ -f "${file}" ]]; then
        echo "export PATH=${install_dir}:\$PATH" >> "${file}"
        source "${file}"
    fi
}

install_dir="${HOME}/.roc/bin"

download_release "${install_dir}"

if [[ -z "${GITHUB_ACTIONS}" ]]; then
    update_shell "${install_dir}" ".bashrc" 
    update_shell "${install_dir}" ".zshrc"
else
    echo "${install_dir}" >> "${GITHUB_PATH}"
fi
