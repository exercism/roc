{%- import "generator_macros.j2" as macros with context -%}
{{ macros.canonical_ref() }}
{{ macros.header() }}

import JigsawData

{% macro render_cases(cases) %}
{%- for case in cases %}
{%- if "cases" in case %}
{{ render_cases(case["cases"]) }}
{%- else %}
# {{ case["description"] }}
expect {
    result = JigsawData.create({{ plugins.prepare_jigsaw_data(case["input"]) | to_roc }})
{%- if case["expected"] is mapping and "error" in case["expected"] %}
    result.is_err()
{%- else %}
    result == Ok({{ plugins.prepare_jigsaw_data(case["expected"]) | to_roc }})
{%- endif %}
}
{%- endif %}

{% endfor %}
{% endmacro %}

{{ render_cases(cases) }}
{{ macros.footer() }}
