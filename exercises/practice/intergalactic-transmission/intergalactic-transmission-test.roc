# These tests are auto-generated with test data from:
# https://github.com/exercism/problem-specifications/tree/main/exercises/intergalactic-transmission/canonical-data.json
# File last updated on 2026-09-20

import IntergalacticTransmission exposing [decode_message, transmit_sequence]

# empty message
expect {
	result = transmit_sequence([])
	result == []
}

# 0x00 is transmitted as 0x0000
expect {
	result = transmit_sequence([0x00])
	result == [0x00, 0x00]
}

# 0x02 is transmitted as 0x0300
expect {
	result = transmit_sequence([0x02])
	result == [0x03, 0x00]
}

# 0x06 is transmitted as 0x0600
expect {
	result = transmit_sequence([0x06])
	result == [0x06, 0x00]
}

# 0x05 is transmitted as 0x0581
expect {
	result = transmit_sequence([0x05])
	result == [0x05, 0x81]
}

# 0x29 is transmitted as 0x2881
expect {
	result = transmit_sequence([0x29])
	result == [0x28, 0x81]
}

# 0xc001c0de is transmitted as 0xc000711be1
expect {
	result = transmit_sequence([0xc0, 0x01, 0xc0, 0xde])
	result == [0xc0, 0x00, 0x71, 0x1b, 0xe1]
}

# six byte message
expect {
	result = transmit_sequence([0x47, 0x72, 0x65, 0x61, 0x74, 0x21])
	result == [0x47, 0xb8, 0x99, 0xac, 0x17, 0xa0, 0x84]
}

# seven byte message
expect {
	result = transmit_sequence([0x47, 0x72, 0x65, 0x61, 0x74, 0x31, 0x21])
	result == [0x47, 0xb8, 0x99, 0xac, 0x17, 0xa0, 0xc5, 0x42]
}

# eight byte message
expect {
	result = transmit_sequence([0xc0, 0x01, 0x13, 0x37, 0xc0, 0xde, 0x21, 0x21])
	result == [0xc0, 0x00, 0x44, 0x66, 0x7d, 0x06, 0x78, 0x42, 0x21, 0x81]
}

# twenty byte message
expect {
	result = transmit_sequence([0x45, 0x78, 0x65, 0x72, 0x63, 0x69, 0x73, 0x6d, 0x20, 0x69, 0x73, 0x20, 0x61, 0x77, 0x65, 0x73, 0x6f, 0x6d, 0x65, 0x21])
	result == [0x44, 0xbd, 0x18, 0xaf, 0x27, 0x1b, 0xa5, 0xe7, 0x6c, 0x90, 0x1b, 0x2e, 0x33, 0x03, 0x84, 0xee, 0x65, 0xb8, 0xdb, 0xed, 0xd7, 0x28, 0x84]
}

# empty message
expect {
	result = decode_message([])?
	result == []
}

# zero message
expect {
	result = decode_message([0x00, 0x00])?
	result == [0x00]
}

# 0x0300 is decoded to 0x02
expect {
	result = decode_message([0x03, 0x00])?
	result == [0x02]
}

# 0x0581 is decoded to 0x05
expect {
	result = decode_message([0x05, 0x81])?
	result == [0x05]
}

# 0x2881 is decoded to 0x29
expect {
	result = decode_message([0x28, 0x81])?
	result == [0x29]
}

# first byte has wrong parity
expect {
	result = decode_message([0x07, 0x00])
	result.is_err()
}

# second byte has wrong parity
expect {
	result = decode_message([0x03, 0x68])
	result.is_err()
}

# 0xcf4b00 is decoded to 0xce94
expect {
	result = decode_message([0xcf, 0x4b, 0x00])?
	result == [0xce, 0x94]
}

# 0xe2566500 is decoded to 0xe2ad90
expect {
	result = decode_message([0xe2, 0x56, 0x65, 0x00])?
	result == [0xe2, 0xad, 0x90]
}

# six byte message
expect {
	result = decode_message([0x47, 0xb8, 0x99, 0xac, 0x17, 0xa0, 0x84])?
	result == [0x47, 0x72, 0x65, 0x61, 0x74, 0x21]
}

# seven byte message
expect {
	result = decode_message([0x47, 0xb8, 0x99, 0xac, 0x17, 0xa0, 0xc5, 0x42])?
	result == [0x47, 0x72, 0x65, 0x61, 0x74, 0x31, 0x21]
}

# last byte has wrong parity
expect {
	result = decode_message([0x47, 0xb8, 0x99, 0xac, 0x17, 0xa0, 0xc5, 0x43])
	result.is_err()
}

# eight byte message
expect {
	result = decode_message([0xc0, 0x00, 0x44, 0x66, 0x7d, 0x06, 0x78, 0x42, 0x21, 0x81])?
	result == [0xc0, 0x01, 0x13, 0x37, 0xc0, 0xde, 0x21, 0x21]
}

# twenty byte message
expect {
	result = decode_message([0x44, 0xbd, 0x18, 0xaf, 0x27, 0x1b, 0xa5, 0xe7, 0x6c, 0x90, 0x1b, 0x2e, 0x33, 0x03, 0x84, 0xee, 0x65, 0xb8, 0xdb, 0xed, 0xd7, 0x28, 0x84])?
	result == [0x45, 0x78, 0x65, 0x72, 0x63, 0x69, 0x73, 0x6d, 0x20, 0x69, 0x73, 0x20, 0x61, 0x77, 0x65, 0x73, 0x6f, 0x6d, 0x65, 0x21]
}

# wrong parity on 16th byte
expect {
	result = decode_message([0x44, 0xbd, 0x18, 0xaf, 0x27, 0x1b, 0xa5, 0xe7, 0x6c, 0x90, 0x1b, 0x2e, 0x33, 0x03, 0x84, 0xef, 0x65, 0xb8, 0xdb, 0xed, 0xd7, 0x28, 0x84])
	result.is_err()
}
