{# Usage: {%- import "generator_macros.j2" as macros -%} #}
{# {{ macros.linebreak(text) }} #}

{%- macro linebreak(s) %}
{%- set parts = s.split(": ") -%}
"{{ parts[0] }}: "
{% for part in parts[1].split(", ") %}
"{{ part }}{% if not loop.last %}, {% endif %}"
{%- endfor %}
{% endmacro -%}

{% macro canonical_ref() -%}
# These tests are auto-generated with test data from:
# https://github.com/exercism/problem-specifications/tree/main/exercises/{{ exercise }}/canonical-data.json
# File last updated on {{ current_date }}
{%- endmacro %}

{% macro header(imports=[], ignore=[], platform=None) -%}

{%- if imports or platform -%}
app [{% if platform %}main!{% endif %}] {
{%- if platform == "parallel" %}
    pf: platform "https://github.com/ageron/roc-parallel/releases/download/0.3.0/ArsAKsVYCn93y2GdXRuMDN5DRrVyb8Fa8BJ3QtxqFxfF.tar.zst",
{%- endif %}
{%- for name in imports -%}
    {% if name == "pf" -%}
    pf: platform "https://github.com/roc-lang/basic-cli/releases/download/0.26.0/GddgvsGjiNXrHFW6au5i5dUDbTs8FinQdrgE2Gqmw53t.tar.zst",
    {%- elif name == "ascii" -%}
    ascii: "https://github.com/ageron/roc-ascii/releases/download/v0.4.2/3D6JMydSyRWk3oRzG92KaZ6cdqhocn7pvSYehjpuPSvz.tar.zst",
    {%- elif name == "isodate" -%}
    isodate: "https://github.com/ageron/roc-isodate/releases/download/v0.8.4/8nYCkCKi8sCi2poruWpkdqTp7W4jnEpKHRK84xKUrmJo.tar.zst",
    {%- elif name == "parser" -%}
    parser: "https://github.com/lukewilliamboswell/roc-parser/releases/download/3.0.0/6xsRdRqenJrAb4wG7HaST4Xh349vD5sHAJDsKTK6E3dr.tar.zst",
    {%- elif name == "random" -%}
    random: "https://github.com/kili-ilo/roc-random/releases/download/0.9.3/HoULZB8QzktiNPYSe9myzy9JQzm1nMbjDPVWoA63QpVf.tar.zst",
    {%- elif name == "unicode" -%}
    unicode: "https://github.com/roc-lang/unicode/releases/download/4.3.1/BNmth7q83JT3Pc2neutkWibVwFwNNNBLhhKfZhmDREeL.tar.zst",
    {%- endif -%}
{%- endfor %}
}

{%- endif %}
{%- endmacro %}

{% macro footer() -%}
{%- endmacro %}
